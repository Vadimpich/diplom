# Offline / air-gapped demo profile.
# Assumes all models are already prepared in ./models and disables HF downloads.

POSTGRES_DB=diplom
POSTGRES_USER=diplom
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST_PORT=5432

RABBITMQ_DEFAULT_USER=diplom
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

MINIO_ROOT_USER=diplom-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=diplom-audio
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

HTTP_ADDR=:8080
CORE_BACKEND_PORT=8080
CORE_BACKEND_HOST_PORT=18080
DATABASE_SSLMODE=disable

FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:18080
INTERNAL_API_BASE_URL=http://core-backend:8080

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://diplom:change-me-rabbitmq-password@rabbitmq:5672/
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_SSL=false
LOG_LEVEL=INFO

PROCESSING_COMMAND_EXCHANGE=processing.commands
PROCESSING_RESULT_EXCHANGE=processing.results
PROCESSING_RESULT_ROUTING_KEY=processing.result
PROCESSING_OUTBOX_MAX_ATTEMPTS=3
WORKER_PREFETCH_COUNT=1

TEXT_WORKER_APP_NAME=text-worker
TEXT_WORKER_PORT=8080
TEXT_WORKER_QUEUE_NAME=qq.processing.text
TEXT_WORKER_COMMAND_ROUTING_KEY=processing.command.text
STT_MODEL_PATH=/app/models/stt
STT_MODEL_SIZE=medium
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
HF_HUB_OFFLINE=1
TEXT_EMOTION_MODEL_PATH=/app/models/text-emotion
TEXT_EMOTION_MODEL_NAME=seara/rubert-base-cased-russian-emotion-detection-ru-go-emotions
TEXT_EMOTION_DEVICE=cpu
TEXT_DEBUG_LOG_STT_TRANSCRIPTS=0
TEXT_DEBUG_LOG_STT_MAX_CHARS=1200

ACOUSTIC_WORKER_APP_NAME=acoustic-worker
ACOUSTIC_WORKER_PORT=8080
ACOUSTIC_WORKER_QUEUE_NAME=qq.processing.acoustic
ACOUSTIC_WORKER_COMMAND_ROUTING_KEY=processing.command.acoustic
ACOUSTIC_MODEL_PATH=/app/models/acoustic-emotion
ACOUSTIC_MODEL_ID=xbgoose/hubert-large-speech-emotion-recognition-russian-dusha-finetuned
ACOUSTIC_DEVICE=cpu

PARALINGUISTIC_WORKER_APP_NAME=paralinguistic-worker
PARALINGUISTIC_WORKER_PORT=8080
PARALINGUISTIC_WORKER_QUEUE_NAME=qq.processing.paralinguistic
PARALINGUISTIC_WORKER_COMMAND_ROUTING_KEY=processing.command.paralinguistic
PARALINGUISTIC_LONG_PAUSE_THRESHOLD_MS=1200
PARALINGUISTIC_MIN_SPEECH_DURATION_MS=700
PARALINGUISTIC_LOW_SPEECH_RATIO_THRESHOLD=0.15
PARALINGUISTIC_VAD_AGGRESSIVENESS=2

BASELINE_SERVICE_URL=http://ml-baseline:8080
BASELINE_HTTP_HOST=0.0.0.0
BASELINE_HTTP_PORT=8080
BASELINE_REQUEST_TIMEOUT_MS=3000
BASELINE_ALGORITHM_VERSION=baseline-v1
BASELINE_MAX_HISTORY=5

KESMI_BASE_URL=http://wimi:8081
KESMI_MODEL_ID=specialists-model-v2-decision
WIMI_AUTOLOAD_MODEL_PATH=/opt/wimi-models/specialists_model_v2_decision.xml
KESMI_TIMEOUT_MS=1000ms
KESMI_MAX_RETRIES=2
KESMI_RETRY_BACKOFF_MS=500ms

JWT_ISSUER=diplom
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

INITIAL_USER_LOGIN=admin
INITIAL_USER_PASSWORD=change-me-admin-password
INITIAL_USER_ROLE=admin
