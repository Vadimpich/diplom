# PostgreSQL
POSTGRES_DB=dimplom
POSTGRES_USER=dimplom
POSTGRES_PASSWORD=dimplom_dev_password
POSTGRES_HOST_PORT=5432

# RabbitMQ
RABBITMQ_DEFAULT_USER=dimplom
RABBITMQ_DEFAULT_PASS=dimplom_dev_password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# MinIO
MINIO_ROOT_USER=dimplom-minio
MINIO_ROOT_PASSWORD=dimplom_minio_dev_password
MINIO_BUCKET=dimplom-audio
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Core backend runtime
HTTP_ADDR=:8080
CORE_BACKEND_PORT=8080
CORE_BACKEND_HOST_PORT=8080
DATABASE_SSLMODE=disable

# Frontend runtime
FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_URL=http://core-backend:8080

# Future backend integrations
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_SSL=false

# Processing topology
PROCESSING_COMMAND_EXCHANGE=processing.commands
PROCESSING_RESULT_EXCHANGE=processing.results
PROCESSING_RESULT_ROUTING_KEY=processing.result
WORKER_PREFETCH_COUNT=1
TEXT_WORKER_APP_NAME=text-worker
TEXT_WORKER_PORT=8080
TEXT_WORKER_QUEUE_NAME=qq.processing.text
TEXT_WORKER_COMMAND_ROUTING_KEY=processing.command.text
ACOUSTIC_WORKER_APP_NAME=acoustic-worker
ACOUSTIC_WORKER_PORT=8080
ACOUSTIC_WORKER_QUEUE_NAME=qq.processing.acoustic
ACOUSTIC_WORKER_COMMAND_ROUTING_KEY=processing.command.acoustic
PARALINGUISTIC_WORKER_APP_NAME=paralinguistic-worker
PARALINGUISTIC_WORKER_PORT=8080
PARALINGUISTIC_WORKER_QUEUE_NAME=qq.processing.paralinguistic
PARALINGUISTIC_WORKER_COMMAND_ROUTING_KEY=processing.command.paralinguistic

# JWT
JWT_ISSUER=dimplom
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Initial bootstrap user for local development
INITIAL_USER_LOGIN=operator
INITIAL_USER_PASSWORD=operator123
INITIAL_USER_ROLE=operator
